#!/usr/bin/env bash
# Keeps ~/.agent-browser/ports, the registry of each repo's Chrome debugging
# port. It keeps two repos off one port. Each line is "<port> <chromeProfile>".
#
#   ports claim <name>          prints a free port for the profile and records it
#   ports record <port> <name>  records the port a repo's Chrome runs on
#
# setup runs claim for a new repo, and record for a repo that already has
# agent-browser.json. browser-start runs record, so a repo set up by hand
# joins the registry the next time its Chrome starts.
set -euo pipefail

# shellcheck source=chrome.sh
. "$(dirname "${BASH_SOURCE[0]}")/chrome.sh"

# A run holds this directory while it reads and writes the registry. mkdir
# makes it or fails in one step, and macOS has no flock.
lock_dir=$registry.lock
# How long a run waits for another run's lock, in seconds.
lock_wait_seconds=${PORTS_LOCK_WAIT_SECONDS:-10}

usage() {
  echo "usage: ports claim <name> | ports record <port> <name>" >&2
  exit 2
}

main() {
  case ${1:-} in
    claim) [ $# -eq 2 ] || usage; claim "$2" ;;
    record) [ $# -eq 3 ] || usage; record "$2" "$3" ;;
    *) usage ;;
  esac
}

claim() {
  if in_container; then
    echo "ports claim reads the Mac's Chrome processes and registry, and $container_rule. Run it on the Mac, with AGENT_BROWSER_CDP unset." >&2
    exit 1
  fi
  need_name "$1"
  lock
  local used port
  port=$(port_for_name "$1")
  if [ -n "$port" ]; then
    echo "$port"
    return 0
  fi
  # A Chrome that a repo set up before the registry existed shows only in ps.
  used=$(registered_ports; chrome_debug_ports)
  for port in $(seq 10100 10199); do
    if ! grep -qx "$port" <<<"$used" && port_unused "$port"; then
      give "$port" "$1"
      echo "$port"
      return 0
    fi
  done
  echo "No free port in 10100-10199. Remove the lines for repos you no longer use from $registry." >&2
  exit 1
}

# Takes the lock, then gives the port. claim calls give itself, because it
# already holds the lock.
record() {
  need_name "$2"
  lock
  give "$1" "$2"
}

# Gives the profile this port, and drops any older line for it. When another
# profile holds the port, give only warns. browser-start then still starts
# Chrome, unless that other profile's Chrome is the one running.
give() {
  local holder
  holder=$(name_for_port "$1")
  [ "$holder" != "$2" ] || return 0
  if [ -n "$holder" ]; then
    echo "$registry gives port $1 to the profile $holder. Two repos on one port drive the same Chrome, so give this repo its own cdp port in agent-browser.json." >&2
    return 0
  fi
  local updated=$registry.$$
  { [ ! -f "$registry" ] || awk -v name="$2" '$2 != name' "$registry"; } >"$updated"
  echo "$1 $2" >>"$updated"
  mv -f "$updated" "$registry"
}

# Takes the registry lock, waiting for a run that holds it. The lock goes
# when this run exits, on error too. A run killed outright still leaves it,
# so the wait ends with a message instead of hanging.
lock() {
  mkdir -p "$(dirname "$registry")"
  local deadline=$(($(date +%s) + lock_wait_seconds))
  until mkdir "$lock_dir" 2>/dev/null; do
    if [ "$(date +%s)" -ge "$deadline" ]; then
      echo "Another ports run has held $lock_dir for $lock_wait_seconds seconds. If no ports run is going, the lock is stale: a killed run left it behind. Remove it with: rmdir $lock_dir" >&2
      exit 1
    fi
    sleep 0.1
  done
  trap 'rmdir "$lock_dir"' EXIT
  trap 'exit 1' HUP INT TERM
}

# Stops the run when the name fails check_name.
need_name() {
  check_name "$1" && return 0
  echo "\"$1\" is not a profile name. $name_rule" >&2
  exit 1
}

registered_ports() {
  [ ! -f "$registry" ] || awk '{ print $1 }' "$registry"
}

main "$@"
