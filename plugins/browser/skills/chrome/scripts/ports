#!/usr/bin/env bash
# Keeps ~/.agent-browser/ports, the registry of each repo's Chrome debugging
# port. It keeps two repos off one port. Each line is "<port> <chromeProfile>".
#
#   ports claim <name>          prints a free port for the profile and records it
#   ports record <port> <name>  records the port a repo's Chrome runs on
#
# The setup skill runs claim for a new repo. browser-start runs record, so a
# repo set up by hand joins the registry the next time its Chrome starts.
set -euo pipefail

registry=$HOME/.agent-browser/ports

# shellcheck source=chrome.sh
. "$(dirname "${BASH_SOURCE[0]}")/chrome.sh"

usage() {
  echo "usage: ports claim <name> | ports record <port> <name>" >&2
  exit 2
}

main() {
  case ${1:-} in
    claim) [ $# -eq 2 ] || usage; claim "$2" ;;
    record) [ $# -eq 3 ] || usage; record "$2" "$3" ;;
    *) usage ;;
  esac
}

claim() {
  if [ "$(uname)" != Darwin ]; then
    echo "ports claim reads the Mac's Chrome processes and registry. Run it on the Mac." >&2
    exit 1
  fi
  check_name "$1"
  local used port
  port=$(port_for_name "$1")
  if [ -n "$port" ]; then
    echo "$port"
    return 0
  fi
  # A Chrome that a repo set up before the registry existed shows only in ps.
  used=$(registered_ports; chrome_debug_ports)
  for port in $(seq 10100 10199); do
    if ! grep -qx "$port" <<<"$used" && port_unused "$port"; then
      record "$port" "$1"
      echo "$port"
      return 0
    fi
  done
  echo "No free port in 10100-10199. Remove the lines for repos you no longer use from $registry." >&2
  exit 1
}

# Gives the profile this port, and drops any older line for it. When another
# profile holds the port, record only warns. browser-start then still starts
# Chrome, unless that other profile's Chrome is the one running.
record() {
  check_name "$2"
  local holder
  holder=$(name_for_port "$1")
  [ "$holder" != "$2" ] || return 0
  if [ -n "$holder" ]; then
    echo "$registry gives port $1 to the profile $holder. Two repos on one port drive the same Chrome, so give this repo its own cdp port in agent-browser.json." >&2
    return 0
  fi
  mkdir -p "$(dirname "$registry")"
  local updated=$registry.$$
  { [ ! -f "$registry" ] || awk -v name="$2" '$2 != name' "$registry"; } >"$updated"
  echo "$1 $2" >>"$updated"
  mv -f "$updated" "$registry"
}

# The name becomes a directory under ~/.agent-browser/profiles, so it holds no
# slash. It is also a field in a registry line, so it holds no space.
check_name() {
  case $1 in
    "" | . | .. | */* | *[[:space:]]*)
      echo "\"$1\" is not a profile name. Give one directory name under ~/.agent-browser/profiles, such as \"people-matcher\"." >&2
      exit 1
      ;;
  esac
}

port_for_name() {
  [ ! -f "$registry" ] || awk -v name="$1" '$2 == name { print $1; exit }' "$registry"
}

name_for_port() {
  [ ! -f "$registry" ] || awk -v port="$1" '$1 == port { print $2; exit }' "$registry"
}

registered_ports() {
  [ ! -f "$registry" ] || awk '{ print $1 }' "$registry"
}

main "$@"
